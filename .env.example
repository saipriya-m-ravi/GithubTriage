GROQ_API_KEY=your-key-here
GROQ_MODEL=model-name
# Optional, reasoning models only (e.g. low / medium / high). Leave empty for the model default.
GROQ_REASONING_EFFORT=

# Optional: LangSmith tracing (sends prompts and outputs to LangSmith). Off by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=githubtriage-dev
