GROQ_API_KEY=your-key-here
GROQ_MODEL=model-name
# Optional, reasoning models only (e.g. low / medium / high). Leave empty for the model default.
GROQ_REASONING_EFFORT=

# Optional: LangSmith tracing (sends prompts and outputs to LangSmith). Off by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=githubtriage-dev

# Optional: where paused runs (checkpoints) and the outbox are stored. Default: .githubtriage
# DATA_DIR=.githubtriage

# GitHub: needed to triage live issues and to post replies. Create a FINE-GRAINED
# personal access token (GitHub → Settings → Developer settings), limited to your
# sandbox repository, with "Issues: Read and write". It can also read public repos.
GITHUB_TOKEN=

# Where approved replies go: "outbox" (default — local files, never touches GitHub)
# or "github" (real comments). "github" also needs GITHUB_TOKEN and an allowlist:
# POST_MODE=outbox
# Comma-separated repositories the bot may post to. Only repos you own!
# POST_ALLOWED_REPOS=your-name/your-sandbox-repo
